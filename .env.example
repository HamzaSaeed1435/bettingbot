GOOGLE_SHEET_ID=
GOOGLE_SERVICE_ACCOUNT_EMAIL=
# Paste the private key from the JSON file (keep the \n line breaks as-is, wrapped in quotes)
GOOGLE_PRIVATE_KEY=""

# Password used to unlock the admin page the first time (change it from the admin page afterwards)
ADMIN_PASSWORD=changeme

# Optional. When set, partners must enter this password before they can see any page.
SITE_PASSWORD=

# Optional. Telegram bot that messages the admin when a withdrawal request comes in.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Optional, defaults to 3000. Most hosts set this automatically.
PORT=3000
